# TeacherSwap Frontend Configuration
# Copy this file to .env and fill in your values.
# NOTE: The frontend is a plain static multi-page app (no build step).
# These values are documented here for convenience; the app reads its
# configuration at runtime (see js/api.js) — never bake secrets here.

# API Base URL for the TeacherSwap backend (used when NOT served by the backend itself).
#
# Resolution order in js/api.js:
#   1. <meta name="api-base-url" content="..."> in each page's <head>
#   2. window.__TS_API_BASE (set before js/api.js loads)
#   3. Auto-detect:
#        - same origin (served by Express backend)        -> <origin>/api
#        - static host / file:// (no /api route)          -> http://localhost:5000/api
#
# For local testing with the backend running on your machine, leave this empty
# (the auto-detect will use http://localhost:5000/api or a same-origin /api).
#
# For a deployed frontend (e.g. GitHub Pages) pointing at a hosted backend, set
# the content of the api-base-url <meta> tag in each HTML page, for example:
#   <meta name="api-base-url" content="https://your-app.fly.dev/api">
API_BASE_URL=

# Google OAuth 2.0 Client ID (for Google Sign-In). Optional.
# Also set via <meta name="google-client-id" content="..."> in each page.
GOOGLE_CLIENT_ID=
