# TeacherSwap Frontend — Configuration Template
# Copy this file to .env if you want a convenient reference (the static
# frontend does NOT read .env at runtime — it reads the api-base-url <meta>
# tag in each HTML page, see frontend/js/api.js). No real secrets belong here.

# API Base URL for the TeacherSwap backend.
# Leave empty for local auto-detection (same-origin /api, or localhost:5000/api).
API_BASE_URL=

# Google OAuth 2.0 Client ID (optional, for Google Sign-In).
GOOGLE_CLIENT_ID=
