# TeacherSwap Configuration
# Copy this file to .env and fill in your values

# Google OAuth 2.0 Client ID (for Google Sign-In)
# Get yours at https://console.cloud.google.com/apis/credentials
# The backend verifies Google ID tokens against this client ID (audience).
# If left empty, the Google Sign-In button will show "not configured" and
# only email/password login will be available. This value is public and is
# exposed to the frontend via GET /api/auth/config (never the client secret).
GOOGLE_CLIENT_ID=

# Google OAuth 2.0 Client Secret (for the redirect flow)
# Used server-side to exchange authorization codes for tokens.
# NEVER expose this to frontend JavaScript.
GOOGLE_CLIENT_SECRET=

# Google OAuth Redirect URI (the callback URL configured in Google Cloud Console)
# Must match exactly what is in Authorized redirect URIs in your OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# JWT Secret (REQUIRED)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start without a JWT_SECRET of at least 16 characters.
# Never commit the real value; keep it in .env only.
JWT_SECRET=replace-with-a-long-random-string-at-least-16-chars

# Server port
PORT=3000
